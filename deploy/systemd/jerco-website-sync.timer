[Unit]
Description=Deploy www.jerconetwork.com from GitHub every 6 hours

[Timer]
# Server clock is UTC: 00:00, 06:00, 12:00, 18:00 UTC = 08:00, 14:00, 20:00, 02:00 WITA
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=300
Persistent=true
Unit=jerco-website-sync.service

[Install]
WantedBy=timers.target
